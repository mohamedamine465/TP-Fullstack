generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FILIERE {
  GINF
  GSEA
  GSR
  GIND
}

enum ROLE {
  ETUDIANT
  ADMIN
}

model Utilisateur {
  id_utilisateur       String      @id @default(cuid())
  nom    String   @unique
  prenom String
  email  String   @unique
  mot_de_passe String
  role ROLE

  etudiant Etudiant?
  administrateur Admin?


}

model Admin {
  id_admin       String      @id @default(cuid())
 
  utilisateur Utilisateur @relation(fields: [id_admin], references: [id_utilisateur])
}

model Etudiant {
  id_etudiant          String      @id @default(cuid())
  CNE         String?   @unique
  filiere    FILIERE?
  formationId String?

  utilisateur Utilisateur @relation(fields: [id_etudiant], references: [id_utilisateur])
  formation Formation? @relation(fields: [formationId], references: [id_formation])
}



model Formation {
  id_formation          String      @id @default(cuid())
  titre      String
  duree     Int

  etudiants  Etudiant[]
}